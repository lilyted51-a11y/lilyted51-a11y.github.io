{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": "auth != null && data.child('m').child(auth.uid).exists()",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid)",
        "host": {
          ".read": "auth != null"
        },
        "open": {
          ".read": "auth != null"
        },
        "m": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (!newData.exists() || data.exists() || (root.child('rooms').child($room).child('open').val() === true))"
          }
        },
        "q": {
          "$to": {
            ".read": "auth != null && auth.uid === $to",
            "$msg": {
              ".write": "auth != null && (auth.uid === $to || root.child('rooms').child($room).child('m').child(auth.uid).exists())",
              ".validate": "!newData.exists() || (newData.isString() && newData.val().length < 200000)"
            }
          }
        },
        "max": {
          ".read": "auth != null"
        },
        "lock": {
          ".read": "auth != null"
        },
        "name": {
          ".read": "auth != null"
        },
        "chat": {
          "$msg": {
            ".write": "auth != null && !data.exists() && root.child('rooms').child($room).child('m').child(auth.uid).exists() && newData.child('u').val() === auth.uid",
            ".validate": "newData.hasChildren(['u', 'n', 't', 'at']) && newData.child('t').isString() && newData.child('t').val().length >= 1 && newData.child('t').val().length <= 200 && newData.child('n').isString() && newData.child('n').val().length <= 20 && newData.child('at').isNumber()"
          }
        }
      }
    },
    "lobby": {
      ".read": "auth != null",
      "$room": {
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid)",
        ".validate": "!newData.exists() || (newData.hasChildren(['host', 'name', 'n', 'max', 'at']) && newData.child('max').isNumber() && newData.child('max').val() >= 2 && newData.child('max').val() <= 10)"
      }
    }
  }
}
